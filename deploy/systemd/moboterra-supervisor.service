[Unit]
Description=MoboTerra CAN and ROS 2 container supervisor
Requires=docker.service
After=docker.service
PartOf=docker.service
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/moboterra/current/moboterra_supervisor.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=50s
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=moboterra-supervisor
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/moboterra-supervisor /var/lib/moboterra

[Install]
WantedBy=multi-user.target

