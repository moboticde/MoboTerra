PLATFORM_CAN_SERIAL=REPLACE_WITH_PLATFORM_ADAPTER_SERIAL
BATTERY_CAN_SERIAL=REPLACE_WITH_BATTERY_ADAPTER_SERIAL
# Wheel modules and per-bus bitrates are selected in platform.yaml.
ROS_DOMAIN_ID=42
ROBOT_NAME=moboterra
INPUT_GID=REPLACE_WITH_HOST_INPUT_GROUP_GID
MOBOTERRA_IMAGE=moboterra:local-jazzy-arm64
MOBOTERRA_GUI_IMAGE=moboterra-gui:local-jazzy-arm64
# Empty lets the container derive critical nodes from ROBOT_NAME.
MOBOTERRA_REQUIRED_NODES=
# Optional policy files inside the read-only /etc/moboterra mount.
DRIVER_PARAMETERS_FILE=
SUPERVISOR_PARAMETERS_FILE=
MANUAL_PARAMETERS_FILE=
SAFETY_PARAMETERS_FILE=
BATTERY_PARAMETERS_FILE=
KINEMATICS_PARAMETERS_FILE=
DIAGNOSTICS_PARAMETERS_FILE=
ODOMETRY_PARAMETERS_FILE=
SCANNER_PARAMETERS_FILE=
CAN_STABLE_SECONDS=3
CAN_POLL_SECONDS=2
ROS_START_TIMEOUT=120
