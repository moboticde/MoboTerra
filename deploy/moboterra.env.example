PLATFORM_CAN_SERIAL=REPLACE_WITH_PLATFORM_ADAPTER_SERIAL
BATTERY_CAN_SERIAL=REPLACE_WITH_BATTERY_ADAPTER_SERIAL
CAN_BITRATE=500000
ROS_DOMAIN_ID=42
INPUT_GID=REPLACE_WITH_HOST_INPUT_GROUP_GID
MOBOTERRA_IMAGE=moboterra:local-jazzy-arm64
MOBOTERRA_GUI_IMAGE=moboterra-gui:local-jazzy-arm64
MOBOTERRA_REQUIRED_NODES=/moboterra/mobotic_supervisor,/moboterra/platform_diagnostics
CAN_STABLE_SECONDS=3
CAN_POLL_SECONDS=2
ROS_START_TIMEOUT=120
