<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>terraspiro_vehicle_supervisor</name>
    <version>0.1.0</version>
    <description>A ROS2 node to supervise vehicle operations, monitoring battery, velocity, and enabling systems.
    </description>
    <maintainer email="tibor.bataljak-savic@romb-technologies.hr">Tibor Bataljak Savić</maintainer>
    <license>Romb Technologies d.o.o.</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>std_srvs</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>terraspiro_sick_interface</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
