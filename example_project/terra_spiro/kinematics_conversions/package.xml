<?xml version="1.0"?>
<package format="3">
    <name>kinematics_conversions</name>
    <version>0.1.0</version>
    <description>A package for mobile robot kinematics conversions.</description>
    <maintainer email="tibor.bataljak-savic@romb-technologies.hr">Tibor Bataljak Savić</maintainer>
    <license>(c) 2025 RoMb Technologies d.o.o. All rights reserved</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>eigen</depend>

    <depend>rclcpp</depend>
    <depend>rclpy</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>ackermann_msgs</depend>
    <depend>std_srvs</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>