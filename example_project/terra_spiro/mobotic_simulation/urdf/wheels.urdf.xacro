<?xml version="1.0"?>

<!-- Macros for front for robot wheels -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="name parent xyz rpy radius length friction damping mu1 mu2">

    <!-- Wheel -->
    <link name="${name}_wheel">
      <visual name="${name}_wheel_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry name="{name}_wheel_geometry">
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial radius="${radius}" length="${length}" mass="30.0" rpy="${pi/2} 0 0"/>
    </link>

    <gazebo reference="${name}_wheel">
      <material value="Gazebo/Wood"/>
    </gazebo>

    <joint name="${name}_traction" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <axis xyz="0 1 0"/>
      <anchor xyz="0 0 0"/>
      <limit effort="100" velocity="100" k_velocity="10"/>
      <joint_properties damping="${damping}" friction="${friction}"/>
    </joint>

    <gazebo reference="${name}_wheel">
      <minDepth value="0.00065"/>
      <kp value="10000000.0" />
      <kd value="1.0" />
      <mu1 value="${mu1}" />
      <mu2 value="${mu2}" />
      <fdir1> 1 0 0 </fdir1>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="wheel_actuated" params="name parent xyz rpy radius length friction damping mu1 mu2">
    <link name="${name}_steering_link">
      <visual name="${name}_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry name="${name}_geometry">
          <cylinder radius="${radius / 8.0}" length="${length * 2}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <xacro:cylinder_inertial radius="${radius / 8.0}" length="${length* 2}" mass="1.0" rpy="${pi/2} 0 0"/>
    </link>
    <gazebo reference="${name}_steering_link">
      <material value="Gazebo/Blue"/>
    </gazebo>

    <!-- steering joint -->
    <joint name="${name}_steering" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}_steering_link"/>
      <axis xyz="0 0 1"/>
      <anchor xyz="0 0 0"/>
      <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="100" velocity="100" k_velocity="0"/>
      <joint_properties damping="1.0" friction="1.0"/>
    </joint>

    <!-- traction joint -->
    <xacro:wheel name="${name}"  parent="${name}_steering_link"  xyz="0 0 0" rpy="0 0 0" radius="${radius}" length="${length}" friction="${friction}" damping="${damping}" mu1="${mu1}" mu2="${mu2}"/>
  </xacro:macro>


  <xacro:macro name="wheel_castor" params="name parent xyz rpy radius length friction damping mu1 mu2">
    <link name="${name}_steering_link">
      <visual name="${name}_visual">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry name="${name}_geometry">
          <cylinder radius="${radius / 8.0}" length="${length * 2}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <xacro:cylinder_inertial radius="${radius / 8.0}" length="${length* 2}" mass="1.0" rpy="${pi/2} 0 0"/>
    </link>
    <gazebo reference="${name}_steering_link">
      <material value="Gazebo/Blue"/>
    </gazebo>

    <!-- steering joint -->
    <joint name="${name}_steering" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}_steering_link"/>
      <axis xyz="0 0 1"/>
      <anchor xyz="0 0 0"/>
      <joint_properties damping="0.0" friction="0.0"/>
    </joint>

    <!-- traction joint -->
    <xacro:wheel name="${name}"  parent="${name}_steering_link"  xyz="0 0 0" rpy="0 0 0" radius="${radius}" length="${length}" friction="${friction}" damping="${damping}" mu1="${mu1}" mu2="${mu2}"/>
  </xacro:macro>
</robot>
