<?xml version="1.0"?>
<!-- Macros for robot inertias -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Macros for simple inertias -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia  ixx="${m*(y*y+z*z)/12}" ixy = "0" ixz = "0"
              iyy="${m*(x*x+z*z)/12}" iyz = "0"
              izz="${m*(x*x+y*y)/12}" />
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length rpy">
    <inertial>
      <mass value="${mass}" />
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0.0" ixz="0.0"
        iyy="${mass * (3 * radius * radius + length * length) / 12}" iyz="0.0"
        izz="${mass * radius * radius / 2}" />
    </inertial>
  </xacro:macro>

   <xacro:macro name="inertial_sphere" params="mass diameter">
    <inertial>
      <mass value="${mass}" />
      <origin xyz="0 0 0" />
      <inertia ixx="${(2/5) * mass * ( (diameter*0.5) * (diameter*0.5) )}" ixy="0.0" ixz="0.0"
               iyy="${(2/5) * mass * ( (diameter*0.5) * (diameter*0.5) )}" iyz="0.0"
               izz="${(2/5) * mass * ( (diameter*0.5) * (diameter*0.5) )}" />
    </inertial>
  </xacro:macro>
</robot>
