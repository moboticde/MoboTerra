<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobotic_bringup</name>
  <version>0.1.0</version>
  <description>Integrated hardware and virtual bringup for MoboTerra.</description>

  <maintainer email="noreply@mobotic.invalid">Mobotic Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mobotic_driver</exec_depend>
  <exec_depend>mobotic_interfaces</exec_depend>
  <exec_depend>mobotic_kinematics</exec_depend>
  <exec_depend>mobotic_odometry</exec_depend>
  <exec_depend>mobotic_manual_control</exec_depend>
  <exec_depend>mobotic_safety</exec_depend>
  <exec_depend>mobotic_supervisor</exec_depend>
  <exec_depend>mobotic_vanguard_battery</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sick_safetyscanners2</exec_depend>
  <exec_depend>ros2_socketcan</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <exec_depend>mobotic_config</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
