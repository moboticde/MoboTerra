<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobotic_kinematics</name>
  <version>0.1.0</version>
  <description>Inverse and forward kinematics for the MoboTerra steerable wheel modules.</description>

  <maintainer email="noreply@mobotic.invalid">Mobotic Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_cmake_test</test_depend>

  <exec_depend>mobotic_config</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
