<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobotic_supervisor</name>
  <version>0.1.0</version>
  <description>Fail-safe command arbitration and vehicle-mode supervision for MoboTerra.</description>

  <maintainer email="noreply@mobotic.invalid">Mobotic Development Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mobotic_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <exec_depend>mobotic_config</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
